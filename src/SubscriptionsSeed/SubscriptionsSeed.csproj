<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Microsoft.eShopWeb.SubscriptionsSeed</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Deliberately shares the PublicApi user-secrets store so this operator tool reads exactly the
      same Maxio configuration the API host runs with, with no second copy to keep in step.
    -->
    <UserSecretsId>20259e3a-d855-48f6-a5c5-130ed9ec78fc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
