<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Microsoft.eShopWeb.SubscriptionsSeed</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Shares the PublicApi user-secrets store so the operator does not maintain a second copy
         of the Maxio configuration. -->
    <UserSecretsId>5b6328e5-682e-4efa-8c3d-66a367f10dad</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsadAli.AdvancedBilling.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
