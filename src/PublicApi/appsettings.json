{
  "baseUrls": {
    "apiBase": "https://localhost:26383/api/",
    "webBase": "https://localhost:26381/"
  },
  "ConnectionStrings": {
    "CatalogConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.CatalogDb;",
    "IdentityConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.Identity;"
  },
  "CatalogBaseUrl": "",
  // Maxio Advanced Billing. ApiKey is a secret and is deliberately absent here: supply it through
  // user-secrets (dotnet user-secrets set "Maxio:ApiKey" ...) or the Maxio__ApiKey environment
  // variable. Leave BaseUrl empty to derive https://{Subdomain}.chargify.com; set it for EU-hosted
  // sites (https://{Subdomain}.ebilling.maxio.com) or to point at a gateway.
  "Maxio": {
    "Subdomain": "",
    "ProductFamilyHandle": "",
    "BaseUrl": "",
    "DefaultPlanHandle": "",
    "PaymentCollectionMethod": "remittance"
  },
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "AllowedHosts": "*"
  }
}

