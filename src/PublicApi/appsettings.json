{
  "baseUrls": {
    "apiBase": "https://localhost:26923/api/",
    "webBase": "https://localhost:26921/"
  },
  "ConnectionStrings": {
    "CatalogConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.CatalogDb;",
    "IdentityConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.Identity;"
  },
  // Maxio Advanced Billing. Values are supplied per environment - user-secrets in development, the
  // host's secret store elsewhere - and are deliberately blank here: no credential belongs in source
  // control. ApiKey, Subdomain and ProductFamilyHandle are required; the rest are optional.
  //   BaseUrl              - overrides the address derived from Subdomain, and is used verbatim.
  //   DefaultPlanHandle    - plan used when POST /api/subscriptions names none.
  //   Environment          - US (default) or EU.
  //   PaymentCollectionMethod - remittance (default), invoice, automatic or prepaid.
  "Maxio": {
    "ApiKey": "",
    "Subdomain": "",
    "BaseUrl": "",
    "ProductFamilyHandle": "",
    "DefaultPlanHandle": "",
    "Environment": "",
    "PaymentCollectionMethod": ""
  },
  "CatalogBaseUrl": "",
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "AllowedHosts": "*"
  }
}

