{
  "baseUrls": {
    "apiBase": "https://localhost:26703/api/",
    "webBase": "https://localhost:26701/"
  },
  "ConnectionStrings": {
    "CatalogConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.CatalogDb;",
    "IdentityConnection": "Server=(localdb)\\mssqllocaldb;Integrated Security=true;Initial Catalog=Microsoft.eShopOnWeb.Identity;"
  },
  "CatalogBaseUrl": "",
  // Maxio Advanced Billing (recurring subscriptions). Values are supplied out of band:
  // user-secrets in development, environment variables or a vault elsewhere. Never commit the API key.
  //   Maxio:ApiKey              - Advanced Billing API key            (env MAXIO_API_KEY)
  //   Maxio:Subdomain           - Advanced Billing site subdomain     (env MAXIO_SITE_SUBDOMAIN)
  //   Maxio:ProductFamilyHandle - product family holding the plans    (env MAXIO_DEFAULT_PRODUCT_FAMILY)
  //   Maxio:BaseUrl             - optional verbatim API base address; overrides Subdomain
  "Maxio": {
    "ApiKey": "",
    "Subdomain": "",
    "ProductFamilyHandle": "",
    "BaseUrl": ""
  },
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "AllowedHosts": "*"
  }
}

