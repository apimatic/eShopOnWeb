<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Vendored, unmodified source of the APIMatic-generated Maxio Advanced Billing .NET SDK
      (github.com/context-plugins/maxio-csharp-sdk, branch main). It is not published to any
      NuGet feed, so it is committed here as a buildable ProjectReference to keep the build
      self-contained and reproducible. This project pins its own package versions, so central
      package management (Directory.Packages.props at the repo root) is disabled for it only.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>$(NoWarn);649</NoWarn>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.8" />
        <PackageReference Include="Polly" Version="8.6.5" />
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Net.Http.Json" Version="10.0.8" />
        <PackageReference Include="System.Net.ServerSentEvents" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>

</Project>