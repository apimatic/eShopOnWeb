<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Vendored source of the APIMatic-generated Maxio Advanced Billing .NET SDK.
      The SDK is not published to a package feed, so it is consumed as source.
      It opts out of the solution's central package management so it can keep the
      exact package versions it was generated against.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>$(NoWarn);649</NoWarn>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.8" />
        <PackageReference Include="Polly" Version="8.6.5" />
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Net.Http.Json" Version="10.0.8" />
        <PackageReference Include="System.Net.ServerSentEvents" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>

</Project>
