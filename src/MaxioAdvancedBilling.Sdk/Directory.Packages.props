<!--
  Vendored third-party SDK (Maxio Advanced Billing, generated by APIMatic; not published to
  NuGet). This file shadows the repository-root Directory.Packages.props so the SDK builds with
  its own inline PackageReference versions and its own netstandard2.0 target framework, isolated
  from the application's central package management and net8.0 default. Do not add app packages here.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
