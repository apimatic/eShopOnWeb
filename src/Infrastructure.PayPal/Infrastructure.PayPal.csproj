<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Microsoft.eShopWeb.Infrastructure.PayPal</RootNamespace>
		<Nullable>enable</Nullable>
		<Description>PayPal payment gateway implementation for eShopOnWeb. Referenced only by hosts that take payments (PublicApi); keeps the PayPal SDK and its newer Microsoft.Extensions dependency closure out of the Web storefront.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AsadAli.Checkout.Sdk" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApplicationCore\ApplicationCore.csproj" />
	</ItemGroup>

</Project>
