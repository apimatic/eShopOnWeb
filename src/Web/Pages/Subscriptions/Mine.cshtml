@page "{handler?}"
@using Microsoft.eShopWeb.ApplicationCore.Entities.SubscriptionAggregate
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.MineModel
@{
    ViewData["Title"] = "My subscriptions";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <article class="esh-catalog-titles row">
        <section class="esh-catalog-title col-xs-12"><h1>My subscriptions</h1></section>
    </article>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.PendingPreview is { } preview)
    {
        <div class="alert alert-info" role="alert">
            <h4>Confirm your plan change</h4>
            <p>
                <strong>@preview.CurrentPlanHandle</strong> &rarr;
                <strong>@(preview.TargetPlanName ?? preview.TargetPlanHandle)</strong>
            </p>
            <p>
                Prorated charge: $ @preview.Charge.ToString("N2") &middot;
                Credit applied: $ @preview.CreditApplied.ToString("N2") &middot;
                <strong>Due now: $ @preview.PaymentDue.ToString("N2")</strong>
            </p>
            <form method="post" asp-page-handler="ChangePlan">
                <input type="hidden" name="subscriptionId" value="@preview.SubscriptionId" />
                <input type="hidden" name="targetPlanHandle" value="@preview.TargetPlanHandle" />
                <input type="hidden" name="timing" value="@PlanChangeTiming.Immediately" />
                <input type="hidden" name="confirmedPaymentDueInCents" value="@preview.PaymentDueInCents" />
                <input type="hidden" name="previewedAt" value="@preview.PreviewedAt.ToString("O")" />
                <button class="btn esh-basket-checkout" type="submit">[ Confirm and apply now ]</button>
            </form>
        </div>
    }

    @if (Model.Subscriptions.Any())
    {
        foreach (var subscription in Model.Subscriptions)
        {
            var allowed = Model.AllowedActions.TryGetValue(subscription.Id, out var actions)
                ? actions
                : Array.Empty<SubscriptionLifecycleAction>();

            <article class="esh-basket-items row">
                <section class="esh-basket-item col-xs-12">
                    <h3>@(subscription.PlanName ?? subscription.PlanHandle ?? "Subscription")</h3>
                    <p>
                        Subscription <code>#@subscription.Id</code> &middot;
                        State: <strong>@subscription.State</strong> &middot;
                        $ @subscription.PlanPrice.ToString("N2") per period
                    </p>
                    <p>
                        @if (subscription.CurrentPeriodStartedAt.HasValue)
                        {
                            <text>Current period started @subscription.CurrentPeriodStartedAt.Value.LocalDateTime.ToString("d") &middot; </text>
                        }
                        Next billing date:
                        @(subscription.NextAssessmentAt?.LocalDateTime.ToString("d")
                            ?? subscription.CurrentPeriodEndsAt?.LocalDateTime.ToString("d")
                            ?? "not scheduled")
                    </p>
                    @if (subscription.CancelAtEndOfPeriod)
                    {
                        <p class="text-danger">
                            Cancellation is scheduled for
                            @(subscription.ScheduledCancellationAt?.LocalDateTime.ToString("d") ?? "the end of the period").
                        </p>
                    }
                    @if (subscription.HasScheduledPlanChange)
                    {
                        <p>A move to <code>@subscription.ScheduledPlanHandle</code> is scheduled for the next renewal.</p>
                    }

                    @if (allowed.Any())
                    {
                        <form method="post" asp-page-handler="Lifecycle" class="form-inline">
                            <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                            <input type="text" class="esh-basket-input" name="reason" placeholder="Reason (optional)" />
                            @foreach (var action in allowed)
                            {
                                <button class="btn esh-basket-checkout" type="submit" name="action" value="@action">
                                    [ @action ]
                                </button>
                            }
                        </form>
                    }
                    else
                    {
                        <p>No lifecycle actions are available from the @subscription.State state.</p>
                    }

                    @if (subscription.IsActive)
                    {
                        <h4>Change plan</h4>
                        <form method="post" class="form-inline">
                            <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                            <select name="targetPlanHandle" class="esh-basket-input">
                                @foreach (var plan in Model.Plans.Where(p => p.Handle != subscription.PlanHandle))
                                {
                                    <option value="@plan.Handle">@plan.Name (@plan.BillingDescription)</option>
                                }
                            </select>
                            <button class="btn esh-basket-checkout" type="submit" asp-page-handler="PreviewPlanChange">
                                [ Preview proration ]
                            </button>
                            <button class="btn esh-basket-checkout" type="submit" asp-page-handler="ChangePlan"
                                    name="timing" value="@PlanChangeTiming.AtNextRenewal">
                                [ Move at next renewal ]
                            </button>
                        </form>

                        <h4>Report usage</h4>
                        <form method="post" asp-page-handler="RecordUsage" class="form-inline">
                            <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                            <input type="number" class="esh-basket-input" name="quantity" min="1" step="1" value="1" />
                            <input type="text" class="esh-basket-input" name="memo" placeholder="Memo (optional)" />
                            <button class="btn esh-basket-checkout" type="submit">[ Record usage ]</button>
                        </form>
                    }
                </section>
            </article>
        }

        @if (Model.Usage is { } usage)
        {
            <article class="esh-basket-items row">
                <section class="esh-basket-item col-xs-12">
                    <h4>Pay-as-you-go this period</h4>
                    <p>
                        Component <code>@usage.ComponentHandle</code> &middot;
                        @if (usage.PeriodToDateAvailable)
                        {
                            <text>@usage.PeriodToDateUnits!.Value.ToString("N0") unit(s) recorded</text>
                            @if (usage.EstimatedPeriodToDateCharge is { } charge)
                            {
                                <text> &middot; approximately $ @charge.ToString("N2") will be added to your next renewal invoice</text>
                            }
                        }
                        else
                        {
                            <text>the running total is unavailable right now</text>
                        }
                    </p>
                </section>
            </article>
        }
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">You have no subscriptions yet.</h3>
    }

    <div class="row">
        <section class="esh-basket-item col-xs-12">
            <a asp-page="./Plans" class="btn esh-basket-checkout text-white">[ Browse plans ]</a>
        </section>
    </div>
</div>
