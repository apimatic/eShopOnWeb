@page "{handler?}"
@model MineModel
@{
    ViewData["Title"] = "My subscriptions";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1 class="esh-catalog-title">My subscriptions</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (!Model.Subscriptions.Any())
    {
        <h3 class="esh-catalog-items row">You have no subscriptions yet.</h3>
        <a asp-page="./Plans" class="btn esh-basket-checkout text-white">[ Browse plans ]</a>
    }
    else
    {
        foreach (var subscription in Model.Subscriptions)
        {
            <article class="esh-basket-items row">
                <div class="card" style="width:100%; margin-bottom:1rem;">
                    <div class="card-body">
                        <h4 class="card-title">
                            @(subscription.PlanName ?? subscription.PlanHandle ?? "Subscription")
                            <small>— @subscription.State</small>
                        </h4>
                        <p class="card-text">
                            <strong>@subscription.PlanPrice.ToString("C")</strong> per period
                            @if (subscription.NextBillingAt.HasValue)
                            {
                                <span> · next billing @subscription.NextBillingAt.Value.ToString("d")</span>
                            }
                            @if (subscription.CurrentPeriodEndsAt.HasValue)
                            {
                                <span> · current period ends @subscription.CurrentPeriodEndsAt.Value.ToString("d")</span>
                            }
                        </p>

                        @if (subscription.CancelAtEndOfPeriod)
                        {
                            <div class="alert alert-warning" role="alert">
                                Cancellation is pending
                                @if (subscription.ScheduledCancellationAt.HasValue)
                                {
                                    <text>and takes effect on @subscription.ScheduledCancellationAt.Value.ToString("d")</text>
                                }.
                            </div>
                        }
                        @if (subscription.HasPendingPlanChange)
                        {
                            <div class="alert alert-info" role="alert">
                                A plan change to <code>@subscription.PendingPlanHandle</code> takes effect at the next renewal.
                            </div>
                        }
                        @if (subscription.AutomaticallyResumeAt.HasValue)
                        {
                            <div class="alert alert-info" role="alert">
                                Paused — resumes automatically on @subscription.AutomaticallyResumeAt.Value.ToString("d").
                            </div>
                        }

                        <h5>Lifecycle</h5>
                        @if (!subscription.AllowedActions.Any())
                        {
                            <p class="card-text"><em>No actions are available while this subscription is @subscription.State.</em></p>
                        }
                        else
                        {
                            @foreach (var action in subscription.AllowedActions)
                            {
                                <form method="post" asp-page-handler="Lifecycle" style="display:inline-block">
                                    <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                    <input type="hidden" name="action" value="@action" />
                                    <button class="btn esh-basket-checkout" type="submit">
                                        [ @(action == SubscriptionLifecycleAction.Cancel ? "Cancel now" : action.ToString()) ]
                                    </button>
                                </form>
                            }

                            @if (subscription.CanApply(SubscriptionLifecycleAction.Cancel, CancellationTiming.EndOfPeriod))
                            {
                                <form method="post" asp-page-handler="Lifecycle" style="display:inline-block">
                                    <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                    <input type="hidden" name="action" value="Cancel" />
                                    <input type="hidden" name="cancellationTiming" value="EndOfPeriod" />
                                    <button class="btn esh-basket-checkout" type="submit">[ Cancel at period end ]</button>
                                </form>
                            }
                        }

                        @if (subscription.IsLive)
                        {
                            <h5>Report usage</h5>
                            <form method="post" asp-page-handler="RecordUsage" class="form-inline">
                                <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                <input type="number" class="esh-basket-input" name="quantity" min="1" step="1" value="1" />
                                <input type="text" class="esh-basket-input" name="memo" placeholder="Memo (optional)" />
                                <button class="btn esh-basket-checkout" type="submit">[ Record usage ]</button>
                            </form>

                            <h5>Change plan</h5>
                            @foreach (var plan in Model.Plans.Where(p => !string.Equals(p.Handle, subscription.PlanHandle, StringComparison.OrdinalIgnoreCase)))
                            {
                                <a asp-page="./ChangePlan"
                                   asp-route-subscriptionId="@subscription.Id"
                                   asp-route-targetPlanHandle="@plan.Handle"
                                   class="btn esh-basket-checkout">
                                    [ Move to @plan.Name — @plan.Price.ToString("C")/@plan.BillingPeriod ]
                                </a>
                            }
                        }
                    </div>
                </div>
            </article>
        }

        <a asp-page="./Plans" class="btn esh-basket-checkout text-white">[ Browse plans ]</a>
    }
</div>
