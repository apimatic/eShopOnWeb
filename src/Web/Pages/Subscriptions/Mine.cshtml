@page "{handler?}"
@using Microsoft.eShopWeb.ApplicationCore.Entities.SubscriptionAggregate
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.MineModel
@{
    ViewData["Title"] = "My subscriptions";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h3 class="esh-catalog-items row">My subscriptions</h3>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (Model.Subscriptions.Any())
    {
        <article class="esh-basket-titles row">
            <section class="esh-basket-title col-xs-3">Plan</section>
            <section class="esh-basket-title col-xs-2">Price</section>
            <section class="esh-basket-title col-xs-2">State</section>
            <section class="esh-basket-title col-xs-2">Next billing</section>
            <section class="esh-basket-title col-xs-3">Manage</section>
        </article>

        @foreach (var subscription in Model.Subscriptions)
        {
            <article class="esh-basket-items row">
                <section class="esh-basket-item esh-basket-item--middle col-xs-3">@subscription.PlanName</section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-2">$ @subscription.PlanPrice.ToString("N2")</section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-2">@subscription.State</section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-2">@subscription.NextBillingAt?.ToString("d")</section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-3">
                    @foreach (var action in SubscriptionStates.LegalTransitionsFrom(subscription.State))
                    {
                        <form method="post" asp-page-handler="Lifecycle" class="d-inline">
                            <input type="hidden" name="subscriptionId" value="@subscription.BillingSubscriptionId" />
                            <input type="hidden" name="action" value="@action" />
                            <input type="hidden" name="endOfPeriod" value="@(action == SubscriptionLifecycleAction.Cancel)" />
                            <button class="btn esh-basket-checkout" type="submit">[ @action ]</button>
                        </form>
                    }
                </section>
            </article>

            <article class="esh-basket-items row">
                <section class="esh-basket-item col-xs-12">
                    <form method="post" asp-page-handler="RecordUsage">
                        <input type="hidden" name="subscriptionId" value="@subscription.BillingSubscriptionId" />
                        <label>Report metered usage</label>
                        <input type="number" class="esh-basket-input" min="1" step="1" name="quantity" value="1" />
                        <input type="text" class="esh-basket-input" name="memo" placeholder="memo (optional)" />
                        <button class="btn esh-basket-checkout" type="submit">[ Record usage ]</button>
                    </form>
                </section>
            </article>
        }
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">You have no subscriptions yet.</h3>
    }

    <section class="esh-basket-item">
        <a asp-page="./Plans" class="btn esh-basket-checkout text-white">[ Browse plans ]</a>
    </section>
</div>
