@page "{handler?}"
@using Microsoft.eShopWeb.ApplicationCore.Entities.SubscriptionAggregate
@model MineModel
@{
    ViewData["Title"] = "My Subscriptions";
}

<div class="esh-orders">
    <div class="container">
        <h1>@ViewData["Title"]</h1>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }

        @if (Model.Preview is not null)
        {
            var preview = Model.Preview;
            <article class="esh-orders-items row">
                <section class="esh-orders-item col-xs-12">
                    <h3>Confirm your plan change</h3>
                    <p>
                        <strong>@preview.CurrentPlanHandle</strong> &rarr; <strong>@preview.TargetPlanHandle</strong>
                        (@(preview.Timing == PlanChangeTiming.Immediate ? "effective now" : "effective at next renewal"))
                    </p>
                    <p>
                        Charge: $ @preview.Charge.ToString("N2") &middot;
                        Credit applied: $ @preview.CreditApplied.ToString("N2") &middot;
                        <strong>Due now: $ @preview.PaymentDue.ToString("N2")</strong>
                    </p>
                    <form method="post" asp-page-handler="ChangePlan">
                        <input type="hidden" name="subscriptionId" value="@preview.SubscriptionId" />
                        <input type="hidden" name="targetPlanHandle" value="@preview.TargetPlanHandle" />
                        <input type="hidden" name="timing" value="@preview.Timing" />
                        <input type="hidden" name="expectedPaymentDueInCents" value="@preview.PaymentDueInCents" />
                        <button class="btn esh-basket-checkout" type="submit">[ Confirm plan change ]</button>
                    </form>
                </section>
            </article>
        }

        @if (Model.Subscriptions.Any())
        {
            <article class="esh-orders-titles row">
                <section class="esh-orders-title col-xs-3">Plan</section>
                <section class="esh-orders-title col-xs-2">Price</section>
                <section class="esh-orders-title col-xs-2">State</section>
                <section class="esh-orders-title col-xs-3">Next billing</section>
                <section class="esh-orders-title col-xs-2">Subscription</section>
            </article>

            @foreach (var subscription in Model.Subscriptions)
            {
                <article class="esh-orders-items row">
                    <section class="esh-orders-item col-xs-3">
                        <strong>@subscription.PlanName</strong>
                        @if (!string.IsNullOrEmpty(subscription.NextPlanHandle))
                        {
                            <div>Moving to @subscription.NextPlanHandle at renewal</div>
                        }
                    </section>
                    <section class="esh-orders-item col-xs-2">$ @subscription.PlanPrice.ToString("N2")</section>
                    <section class="esh-orders-item col-xs-2">
                        @subscription.State
                        @if (subscription.CancelAtEndOfPeriod)
                        {
                            <div>Ends at period close</div>
                        }
                    </section>
                    <section class="esh-orders-item col-xs-3">
                        @(subscription.NextAssessmentAt.HasValue ? subscription.NextAssessmentAt.Value.ToString("d") : "—")
                    </section>
                    <section class="esh-orders-item col-xs-2">
                        #@subscription.Id
                        @if (Model.Highlight == subscription.Id)
                        {
                            <strong> (new)</strong>
                        }
                    </section>
                </article>

                @if (subscription.IsLive)
                {
                    <article class="esh-orders-items row">
                        <section class="esh-orders-item col-xs-6">
                            <h4>Report usage</h4>
                            <form method="post" asp-page-handler="RecordUsage">
                                <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                <input type="number" class="esh-basket-input" name="quantity" min="1" step="1" value="1" />
                                <input type="text" class="esh-basket-input" name="memo" placeholder="Memo (optional)" />
                                <button class="btn esh-basket-checkout" type="submit">[ Record usage ]</button>
                            </form>
                            @if (Model.UsageReport is not null && Model.UsageReport.Record.SubscriptionId == subscription.Id)
                            {
                                <p>
                                    Period to date:
                                    @if (Model.UsageReport.PeriodToDateAvailable)
                                    {
                                        <text>@Model.UsageReport.PeriodToDateQuantity unit(s) — $ @Model.UsageReport.PeriodToDateCharge!.Value.ToString("N2")</text>
                                    }
                                    else
                                    {
                                        <text>temporarily unavailable</text>
                                    }
                                </p>
                            }
                        </section>

                        <section class="esh-orders-item col-xs-6">
                            <h4>Change plan</h4>
                            @foreach (var target in Model.PlanChangeTargetsFor(subscription))
                            {
                                <form method="post" asp-page-handler="PreviewPlanChange">
                                    <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                    <input type="hidden" name="targetPlanHandle" value="@target.Handle" />
                                    <select name="timing" class="esh-basket-input">
                                        <option value="@PlanChangeTiming.Immediate">Now (prorated)</option>
                                        <option value="@PlanChangeTiming.AtNextRenewal">At next renewal</option>
                                    </select>
                                    <button class="btn esh-basket-checkout" type="submit">
                                        [ Preview @target.Name — $ @target.Price.ToString("N2") ]
                                    </button>
                                </form>
                            }
                        </section>
                    </article>
                }

                <article class="esh-orders-items row">
                    <section class="esh-orders-item col-xs-12">
                        <h4>Manage</h4>
                        @if (!subscription.AllowedTransitions.Any())
                        {
                            <span>No actions are available for a subscription in state @subscription.State.</span>
                        }
                        @foreach (var action in subscription.AllowedTransitions)
                        {
                            <form method="post" asp-page-handler="Lifecycle" style="display:inline-block">
                                <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                <input type="hidden" name="action" value="@action" />
                                @if (action == SubscriptionLifecycleAction.Cancel)
                                {
                                    <select name="cancellationTiming" class="esh-basket-input">
                                        <option value="@CancellationTiming.EndOfPeriod">At period end</option>
                                        <option value="@CancellationTiming.Immediate">Immediately</option>
                                    </select>
                                    <input type="text" class="esh-basket-input" name="reason" placeholder="Reason (optional)" />
                                }
                                else
                                {
                                    <input type="hidden" name="cancellationTiming" value="@CancellationTiming.Immediate" />
                                }
                                <button class="btn esh-basket-checkout" type="submit">[ @action ]</button>
                            </form>
                        }
                    </section>
                </article>
            }
        }
        else if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <h3 class="esh-catalog-items row">You have no subscriptions yet.</h3>
        }

        <div class="row">
            <section class="esh-basket-item col-xs-4">
                <a asp-page="./Plans" class="btn esh-basket-checkout text-white">[ Browse plans ]</a>
            </section>
        </div>
    </div>
</div>
