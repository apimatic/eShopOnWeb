@page "{handler?}"
@model MineModel
@{
    ViewData["Title"] = "My subscriptions";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1>My subscriptions</h1>

    @if (Model.Message is not null)
    {
        <div class="alert alert-success" role="alert">@Model.Message</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Preview is not null)
    {
        var preview = Model.Preview;
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">Confirm your plan change</h4>
                <p>
                    <strong>@preview.CurrentPlanHandle</strong> &rarr; <strong>@preview.TargetPlanHandle</strong>
                    (@preview.Timing)
                </p>
                <ul>
                    <li>Prorated adjustment: $ @preview.ProratedAdjustment.ToString("N2")</li>
                    <li>Charge for the new plan: $ @preview.Charge.ToString("N2")</li>
                    <li>Credit applied: $ @preview.CreditApplied.ToString("N2")</li>
                    <li><strong>Due now: $ @preview.PaymentDue.ToString("N2")</strong></li>
                </ul>
                <form method="post" asp-page-handler="ChangePlan">
                    <input type="hidden" name="subscriptionId" value="@preview.SubscriptionId" />
                    <input type="hidden" name="currentPlanHandle" value="@preview.CurrentPlanHandle" />
                    <input type="hidden" name="targetPlanHandle" value="@preview.TargetPlanHandle" />
                    <input type="hidden" name="timing" value="@preview.Timing" />
                    <input type="hidden" name="proratedAdjustmentInCents" value="@preview.ProratedAdjustmentInCents" />
                    <input type="hidden" name="chargeInCents" value="@preview.ChargeInCents" />
                    <input type="hidden" name="paymentDueInCents" value="@preview.PaymentDueInCents" />
                    <input type="hidden" name="creditAppliedInCents" value="@preview.CreditAppliedInCents" />
                    <button class="btn btn-primary" type="submit">Confirm change</button>
                </form>
            </div>
        </div>
    }

    @if (!Model.Subscriptions.Any())
    {
        <p>You have no subscriptions yet. <a asp-page="./Plans">Browse the plans</a>.</p>
    }
    else
    {
        @foreach (var subscription in Model.Subscriptions)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h4 class="card-title">@subscription.PlanName <small>(@subscription.PlanHandle)</small></h4>
                    <p>
                        $ @subscription.PlanPrice.ToString("N2") per month &middot;
                        state <strong>@subscription.State</strong>
                        @if (subscription.CurrentPeriodEndsAt is not null)
                        {
                            <text>&middot; next billing @subscription.CurrentPeriodEndsAt.Value.ToString("d")</text>
                        }
                    </p>

                    @if (subscription.CancelAtEndOfPeriod)
                    {
                        <p class="text-danger">Scheduled to cancel at the end of the current period.</p>
                    }
                    @if (subscription.NextPlanHandle is not null)
                    {
                        <p>Changing to <strong>@subscription.NextPlanHandle</strong> at the next renewal.</p>
                    }

                    @if (Model.Usage.TryGetValue(subscription.Id, out var usage))
                    {
                        <h5>Pay-as-you-go usage (@usage.ComponentHandle)</h5>
                        @if (!usage.TotalAvailable)
                        {
                            <p>The running total is temporarily unavailable.</p>
                        }
                        else
                        {
                            <p>
                                @usage.PeriodToDateQuantity.ToString("0.##") unit(s) this period
                                @if (usage.EstimatedCharge is not null)
                                {
                                    <text>&middot; $ @usage.EstimatedCharge.Value.ToString("N2") on your next invoice</text>
                                }
                            </p>
                        }

                        <form method="post" asp-page-handler="Usage" class="form-inline mb-3">
                            <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                            <input type="number" class="form-control" name="quantity" value="1" min="1" step="1" />
                            <input type="text" class="form-control" name="memo" placeholder="memo (optional)" />
                            <button class="btn btn-secondary" type="submit">Report usage</button>
                        </form>
                    }

                    @if (subscription.CanChangePlan)
                    {
                        var targets = Model.Plans.Where(p => p.Handle != subscription.PlanHandle).ToList();
                        @if (targets.Any())
                        {
                            <form method="post" asp-page-handler="Preview" class="form-inline mb-3">
                                <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                                <select class="form-control" name="targetPlanHandle">
                                    @foreach (var plan in targets)
                                    {
                                        <option value="@plan.Handle">@plan.Name ($ @plan.Price.ToString("N2"))</option>
                                    }
                                </select>
                                <select class="form-control" name="timing">
                                    <option value="Immediately">Now, prorated</option>
                                    <option value="AtNextRenewal">At next renewal</option>
                                </select>
                                <button class="btn btn-secondary" type="submit">Preview change</button>
                            </form>
                        }
                    }

                    <form method="post" asp-page-handler="Lifecycle" class="form-inline">
                        <input type="hidden" name="subscriptionId" value="@subscription.Id" />
                        <select class="form-control" name="action">
                            @foreach (var action in subscription.LegalActions.Where(a => a != SubscriptionActions.ChangePlan))
                            {
                                <option value="@action">@action</option>
                            }
                        </select>
                        <select class="form-control" name="timing">
                            <option value="Immediate">Immediately (cancel only)</option>
                            <option value="EndOfPeriod">End of period (cancel only)</option>
                        </select>
                        <input type="text" class="form-control" name="reason" placeholder="reason (optional)" />
                        <button class="btn btn-secondary" type="submit">Apply</button>
                    </form>
                </div>
            </div>
        }
    }

    <p><a asp-page="./Plans">Browse all plans</a></p>
</div>
