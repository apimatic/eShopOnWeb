@page "{handler?}"
@model PlansModel
@{
    ViewData["Title"] = "Subscription plans";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1 class="esh-catalog-title">Subscription plans</h1>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Plans.Any())
    {
        <div class="esh-catalog-items row">
            @foreach (var plan in Model.Plans)
            {
                var isCurrent = string.Equals(plan.Handle, Model.CurrentPlanHandle, StringComparison.OrdinalIgnoreCase);
                <div class="esh-catalog-item col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">@plan.Name</h4>
                            <p class="esh-catalog-price"><span>@plan.Price.ToString("C") / @plan.BillingPeriod</span></p>
                            @if (!string.IsNullOrEmpty(plan.Description))
                            {
                                <p class="card-text">@plan.Description</p>
                            }
                            <p class="card-text"><small>Plan handle: <code>@plan.Handle</code></small></p>

                            @if (isCurrent)
                            {
                                <span class="btn esh-basket-checkout disabled">[ Current plan ]</span>
                                <a asp-page="./Mine" class="btn esh-basket-checkout text-white">[ Manage ]</a>
                            }
                            else if (Model.CurrentSubscriptionId.HasValue)
                            {
                                <a asp-page="./ChangePlan"
                                   asp-route-subscriptionId="@Model.CurrentSubscriptionId.Value"
                                   asp-route-targetPlanHandle="@plan.Handle"
                                   class="btn esh-basket-checkout">[ Switch to this plan ]</a>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Subscribe">
                                    <input type="hidden" name="planHandle" value="@plan.Handle" />
                                    <button class="btn esh-basket-checkout" type="submit">[ Subscribe ]</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">No subscription plans are available.</h3>
    }
</div>
