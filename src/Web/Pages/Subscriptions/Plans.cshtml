@page
@model PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1>@ViewData["Title"]</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }

    @if (!Model.Plans.Any())
    {
        <p>No plans are available right now.</p>
    }
    else
    {
        <div class="row">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-xs-12 col-md-6">
                    <article class="esh-basket-items row" style="margin-bottom: 1em; padding: 1em;">
                        <div>
                            <h3>@plan.Name</h3>
                            <p>$ @((plan.PriceInCents / 100m).ToString("N2")) / @plan.IntervalUnit.ToLowerInvariant()</p>
                            <form method="post" asp-page-handler="Subscribe">
                                <input type="hidden" name="planHandle" value="@plan.Handle" />
                                <button type="submit" class="btn esh-basket-checkout">[ Subscribe ]</button>
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    <p><a asp-page="/Subscriptions/Mine">My Subscriptions</a></p>
</div>
