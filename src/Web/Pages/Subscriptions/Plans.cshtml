@page
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<div class="esh-orders">
    <div class="container">
        <h1>@ViewData["Title"]</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="text-danger">@Model.ErrorMessage</div>
        }

        <article class="esh-orders-titles row">
            <section class="esh-orders-title col-xs-3">Plan</section>
            <section class="esh-orders-title col-xs-2">Price</section>
            <section class="esh-orders-title col-xs-2">Billing interval</section>
            <section class="esh-orders-title col-xs-2"></section>
        </article>

        @if (Model.Plans.Any())
        {
            @foreach (var plan in Model.Plans)
            {
                <article class="esh-orders-items row">
                    <section class="esh-orders-item col-xs-3">@plan.Name</section>
                    <section class="esh-orders-item col-xs-2">$ @((plan.PriceInCents / 100m).ToString("N2"))</section>
                    <section class="esh-orders-item col-xs-2">every @plan.Interval @plan.IntervalUnit</section>
                    <section class="esh-orders-item col-xs-2">
                        <form method="post" asp-page-handler="Subscribe">
                            <input type="hidden" name="productHandle" value="@plan.Handle" />
                            <button type="submit" class="btn esh-basket-checkout">Subscribe</button>
                        </form>
                    </section>
                </article>
            }
        }
        else if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <h3 class="esh-catalog-items row">No plans are currently available.</h3>
        }

        <p><a asp-page="./Mine">View my subscriptions</a></p>
    </div>
</div>
