@page
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h2>Subscription Plans</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }

    @if (Model.ActiveSubscription != null)
    {
        <p>
            You already have an active subscription on <strong>@Model.ActiveSubscription.ProductName</strong>.
            <a asp-page="Mine">Manage your subscription</a>.
        </p>
    }
    else if (!Model.Plans.Any())
    {
        <p>No plans are currently available.</p>
    }
    else
    {
        <div class="row">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-md-4">
                    <div class="esh-basket-items" style="padding: 1em; margin-bottom: 1em;">
                        <h3>@plan.Name</h3>
                        <p>$@((plan.PriceInCents / 100m).ToString("N2")) / @plan.IntervalUnit</p>
                        <form method="post" asp-page-handler="Subscribe">
                            <input type="hidden" name="productHandle" value="@plan.Handle" />
                            <button type="submit" class="btn esh-basket-checkout">[ Subscribe ]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
