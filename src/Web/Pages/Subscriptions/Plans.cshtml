@page
@model PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h2>Subscription Plans</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Plans.Any())
    {
        <article class="esh-basket-titles row">
            <section class="esh-basket-title col-xs-4">Plan</section>
            <section class="esh-basket-title col-xs-2">Price</section>
            <section class="esh-basket-title col-xs-2">Billing</section>
            <section class="esh-basket-title col-xs-4"></section>
        </article>
        @foreach (var plan in Model.Plans)
        {
            <article class="esh-basket-items row">
                <section class="esh-basket-item col-xs-4">@plan.Name</section>
                <section class="esh-basket-item col-xs-2">$ @((plan.PriceInCents / 100m).ToString("N2"))</section>
                <section class="esh-basket-item col-xs-2">per @plan.IntervalUnit</section>
                <section class="esh-basket-item col-xs-4">
                    <form method="post" asp-page-handler="Subscribe">
                        <input type="hidden" name="productHandle" value="@plan.Handle" />
                        <button class="btn esh-basket-checkout" type="submit">[ Subscribe ]</button>
                    </form>
                </section>
            </article>
        }
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">No plans are currently available.</h3>
    }

    <section class="esh-basket-item" style="margin-top:1em;">
        <a asp-page="/Subscriptions/Mine" class="btn esh-basket-checkout">[ My Subscriptions ]</a>
    </section>
</div>
