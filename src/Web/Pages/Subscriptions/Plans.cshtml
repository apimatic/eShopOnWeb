@page
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h2>Subscription Plans</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }
    @if (Model.ConfirmationMessage != null)
    {
        <div class="esh-basket-title">@Model.ConfirmationMessage</div>
    }

    <article class="esh-catalog-items row">
        @foreach (var plan in Model.Plans)
        {
            <section class="esh-basket-items row">
                <div class="esh-basket-item esh-basket-item--middle col-xs-4">
                    <strong>@plan.Name</strong>
                </div>
                <div class="esh-basket-item esh-basket-item--middle col-xs-3">
                    $ @plan.Price.ToString("N2") @plan.DisplayInterval
                </div>
                <div class="esh-basket-item esh-basket-item--middle col-xs-3">
                    <form method="post" asp-page-handler="Subscribe">
                        <input type="hidden" name="planHandle" value="@plan.Handle" />
                        <button type="submit" class="btn esh-basket-checkout">[ Subscribe ]</button>
                    </form>
                </div>
            </section>
        }
    </article>

    @if (!Model.Plans.Any() && Model.ErrorMessage == null)
    {
        <p>No subscription plans are currently available.</p>
    }

    <p><a asp-page="/Subscriptions/Mine">View my subscriptions</a></p>
</div>
