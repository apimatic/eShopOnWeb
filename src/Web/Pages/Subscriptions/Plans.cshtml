@page "{handler?}"
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription plans";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <article class="esh-catalog-titles row">
        <section class="esh-catalog-title col-xs-12"><h1>Subscription plans</h1></section>
    </article>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Plans.Any())
    {
        <div class="esh-catalog-items row">
            @foreach (var plan in Model.Plans)
            {
                var alreadySubscribed = Model.SubscribedPlanHandles.Contains(plan.Handle);
                <div class="esh-catalog-item col-md-4">
                    <div class="esh-basket-items">
                        <h3 class="esh-catalog-name">@plan.Name</h3>
                        <div class="esh-catalog-price"><span>@plan.BillingDescription</span></div>
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                            <p>@plan.Description</p>
                        }
                        <p class="esh-basket-item">Plan code: <code>@plan.Handle</code></p>
                        @if (plan.RequiresPaymentMethod)
                        {
                            <p class="text-danger">This plan requires a payment method on file.</p>
                        }

                        @if (alreadySubscribed)
                        {
                            <a asp-page="./Mine" class="btn esh-basket-checkout">[ Manage subscription ]</a>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Subscribe">
                                <input type="hidden" name="planHandle" value="@plan.Handle" />
                                <button class="btn esh-basket-checkout" type="submit">[ Subscribe ]</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="row">
            <section class="esh-basket-item col-xs-12">
                <a asp-page="./Mine" class="btn esh-basket-checkout text-white">[ My subscriptions ]</a>
            </section>
        </div>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">No subscription plans are available.</h3>
    }
</div>
