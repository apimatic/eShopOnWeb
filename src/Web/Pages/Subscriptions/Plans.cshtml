@page
@model PlansModel
@{
    ViewData["Title"] = "Subscription plans";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1>Subscription plans</h1>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    @if (!Model.Plans.Any())
    {
        @if (Model.ErrorMessage is null)
        {
            <p>There are no subscription plans available at the moment.</p>
        }
    }
    else
    {
        <div class="esh-catalog-items row">
            @foreach (var plan in Model.Plans)
            {
                <div class="esh-catalog-item col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">@plan.Name</h4>
                            <p class="esh-catalog-price">
                                <span>$ @plan.Price.ToString("N2")</span>
                                <small>per @(plan.Interval > 1 ? $"{plan.Interval} {plan.IntervalUnit}s" : plan.IntervalUnit)</small>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <p class="card-text">@plan.Description</p>
                            }
                            <form method="post">
                                <input type="hidden" name="planHandle" value="@plan.Handle" />
                                <button class="btn btn-primary" type="submit">Subscribe</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <p><a asp-page="./Mine">View my subscriptions</a></p>
</div>
