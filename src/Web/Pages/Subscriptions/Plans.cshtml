@page
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h1>Subscription Plans</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Plans.Any())
    {
        <div class="row">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="card-body">
                            <h3 class="card-title">@plan.Name</h3>
                            <p class="card-text">
                                <strong>@((plan.PriceInCents / 100m).ToString("C"))</strong> / @plan.IntervalCount @(plan.IntervalUnit)(s)
                            </p>
                            <form method="post" asp-page-handler="Subscribe">
                                <input type="hidden" name="productHandle" value="@plan.Handle" />
                                <button type="submit" class="esh-basket-checkout">Subscribe</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p>No plans are currently available.</p>
    }

    <p><a asp-page="Mine">View my subscriptions</a></p>
</div>
