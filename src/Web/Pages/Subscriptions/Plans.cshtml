@page
@model Microsoft.eShopWeb.Web.Pages.Subscriptions.PlansModel
@{
    ViewData["Title"] = "Subscription plans";
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h3 class="esh-catalog-items row">Subscription plans</h3>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (Model.Plans.Any())
    {
        <article class="esh-basket-titles row">
            <section class="esh-basket-title col-xs-4">Plan</section>
            <section class="esh-basket-title col-xs-4">Price</section>
            <section class="esh-basket-title col-xs-4"></section>
        </article>

        @foreach (var plan in Model.Plans)
        {
            <article class="esh-basket-items row">
                <section class="esh-basket-item esh-basket-item--middle col-xs-4">@plan.Name</section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-4">
                    $ @plan.Price.ToString("N2") / @plan.Interval @plan.IntervalUnit
                </section>
                <section class="esh-basket-item esh-basket-item--middle col-xs-4">
                    <form method="post">
                        <input type="hidden" name="planHandle" value="@plan.Handle" />
                        <button class="btn esh-basket-checkout" type="submit">[ Subscribe ]</button>
                    </form>
                </section>
            </article>
        }
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <h3 class="esh-catalog-items row">No subscription plans are available.</h3>
    }

    <section class="esh-basket-item">
        <a asp-page="./Mine" class="btn esh-basket-checkout text-white">[ My subscriptions ]</a>
    </section>
</div>
