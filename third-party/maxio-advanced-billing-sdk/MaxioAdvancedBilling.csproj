<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Vendored, generated Maxio Advanced Billing .NET SDK (APIMatic), source repo
        github.com/context-plugins/maxio-csharp-sdk (branch main). Vendored because the SDK is
        not published to any package feed. Only buildable source is included (map/ docs omitted).
        Do not edit generated files by hand; regenerate from the SDK repo instead.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>$(NoWarn);649</NoWarn>
        <!-- This project pins its own package versions inline; exempt it from the repo's central package management. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />
        <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.8" />
        <PackageReference Include="Polly" Version="8.6.5" />
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.Net.Http.Json" Version="10.0.8" />
        <PackageReference Include="System.Net.ServerSentEvents" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>

</Project>