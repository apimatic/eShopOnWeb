<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Twilio .NET SDK is not published to a feed; it is vendored as a locally-built package. -->
    <add key="twilio-local" value="lib/twilio-sdk" />
  </packageSources>
</configuration>
