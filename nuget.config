<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local feed for the Maxio Advanced Billing SDK, which is distributed as source only
         (not published to any public feed). The .nupkg under ./libs is built from the SDK
         source and vendored so the solution restores reproducibly with no external private feed. -->
    <add key="local-maxio" value="./libs" />
  </packageSources>
</configuration>
